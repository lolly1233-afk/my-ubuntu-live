{
  "name": "Ubuntu Desktop",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "nonPersistent": false
    }
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "sudo apt update && sudo apt install -y wine winetricks"
}
